# geminirouter Production Caddyfile
# Automatic HTTPS via Let's Encrypt / ZeroSSL

{$DOMAIN:your-domain.com} {
    # Logging
    log {
        output file /var/log/caddy/geminirouter.log {
            roll_size 10mb
            roll_keep 10
        }
    }

    # Compression (Gzip + Zstandard)
    encode zstd gzip

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # =========================================================================
    # 1. Long media and image generation: /v1/audio/*, /v1/media/*, /v1/images/*
    # These reach the bridge (port 3000). Media is streamed and chunked; image
    # generation is forwarded to the core through the normal lease path.
    # =========================================================================
    @media {
        path /v1/audio/* /v1/media/* /v1/images/*
    }

    handle @media {
        reverse_proxy 127.0.0.1:3000 {
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}

            transport http {
                response_header_timeout 7200s
                read_timeout 7200s
            }
        }
    }

    # =========================================================================
    # 2. API Endpoints: /v1/* & /v1beta/*
    # Open for AI coding tools (Claude Code, Cursor, Codex, SDKs).
    # Protected by Bearer API Key checked against {$API_KEY} if basic header filter desired,
    # or passed through directly to geminirouter backend for validation & metering.
    # =========================================================================
    # Gemini-native clients (the dubbing service) use /v1beta/models/... and go
    # through the bridge, so leases, quota checks and failover apply to them.
    @v1beta {
        path /v1beta/*
    }

    handle @v1beta {
        reverse_proxy 127.0.0.1:3000 {
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}

            transport http {
                response_header_timeout 600s
                read_timeout 600s
            }
        }
    }

    # The model listing is answered by the bridge so retired aliases (for
    # example gemini-3.8-flash-tiered) never appear in a public response.
    @models {
        path /v1/models
    }

    handle @models {
        reverse_proxy 127.0.0.1:3000 {
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}

            transport http {
                response_header_timeout 60s
                read_timeout 60s
            }
        }
    }

    @api {
        path /v1/*
    }

    # If you wish to enforce API key check directly at Caddy level, uncomment below:
    # @unauthorized {
    #     path /v1/* /v1beta/*
    #     not header Authorization "Bearer {$API_KEY}"
    # }
    # respond @unauthorized "Unauthorized: Invalid API Key" 401

    # All OpenAI-compatible traffic goes through the bridge so request model
    # ids are canonicalised (retired gemini-3.8 aliases are rewritten) and the
    # dashboard traffic records match what the gateway exposes.
    handle @api {
        reverse_proxy 127.0.0.1:3000 {
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}

            # Extended timeouts for long streaming AI chat completions
            transport http {
                response_header_timeout 600s
                read_timeout 600s
            }
        }
    }

    # =========================================================================
    # 3. Web Management Dashboard & RPC API
    # Protected by HTTP Basic Auth so only you can access the admin dashboard.
    # =========================================================================
    @dashboard {
        not path /v1/* /v1beta/*
    }

    handle @dashboard {
        # HTTP Basic Authentication for web dashboard and management RPC
        # Generate hash using: caddy hash-password --plaintext "YOUR_PASSWORD"
        basic_auth {
            {$DASHBOARD_USER:admin} {$DASHBOARD_PASSWORD_HASH:$2a$14$Z7Xo6t0N...}
        }

        # Route to Web Dashboard (Port 3000) or Core Dashboard (Port 8045)
        reverse_proxy 127.0.0.1:3000 {
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}

            # WebSocket support for live log streaming / RPC
            header_up Upgrade {>Upgrade}
            header_up Connection {>Connection}

            # Large Playground uploads can take a long time to process.
            transport http {
                response_header_timeout 7200s
                read_timeout 7200s
            }
        }
    }
}

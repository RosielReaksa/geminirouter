# geminirouter Production Environment Variables
# Copy to /opt/geminirouter/.env and adjust values

# Node Environment
NODE_ENV=production

# Server Ports
CORE_PORT=8045
WEB_PORT=3000
PORT=8045

# Domain & Reverse Proxy
DOMAIN=router.yourdomain.com

# Master API Key (sk-live-...) for OpenAI / Anthropic compatible client tools
# Used by Claude Code, Codex, Cursor, Aider, OpenCode, etc.
GEMINIROUTER_API_KEY=sk-live-replace_with_secure_random_hex_or_uuid

# Web Dashboard Basic Auth (Caddy / Nginx)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace_with_secure_password
DASHBOARD_PASSWORD_HASH=

# Storage & Logging
DATA_DIR=/opt/geminirouter/data
LOG_DIR=/opt/geminirouter/logs

# Upstream Antigravity / Google Configuration (optional overrides)
REQUEST_TIMEOUT_MS=600000
MAX_CONCURRENT_REQUESTS_PER_ACCOUNT=10

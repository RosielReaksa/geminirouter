# geminirouter Production Environment Variables
# Copy to /opt/geminirouter/.env and adjust values

# Node Environment
NODE_ENV=production

# Server Ports
CORE_PORT=8045
WEB_PORT=3000
PORT=8045

# Domain & Reverse Proxy
DOMAIN=router.yourdomain.com

# Master API Key (sk-live-...) for OpenAI / Anthropic compatible client tools
# Used by Claude Code, Codex, Cursor, Aider, OpenCode, etc.
GEMINIROUTER_API_KEY=sk-live-replace_with_secure_random_hex_or_uuid

# Web Dashboard Basic Auth (Caddy / Nginx)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace_with_secure_password
DASHBOARD_PASSWORD_HASH=

# Storage & Logging
DATA_DIR=/opt/geminirouter/data
LOG_DIR=/opt/geminirouter/logs

# External AntigravityManager core (NOT bundled in this repository)
# Point these at your own installation of the core.
CORE_HOME=/opt/geminirouter/core
CORE_MAIN_PATH=/opt/geminirouter/core/dist/core/main.cjs

# Frontend build location (optional, auto-detected by default)
# FRONTEND_DIST=/opt/geminirouter/frontend/dist

# Hosted Google sign-in callback (public HTTPS URL registered in Google Cloud)
# OAUTH_CALLBACK_URL=https://router.yourdomain.com/oauth/callback

# Custom Google OAuth clients for the core (advanced).
# Format: key|client_id|client_secret|label   (multiple entries separated by ";")
# NOTE: Antigravity requires the private `aicode` scope, which only Antigravity's
# own client may request. Custom web clients fail with `invalid_scope`.
# ANTIGRAVITY_OAUTH_CLIENTS=framecall_web|<client_id>|<client_secret>|Framecall Web
# Active client used when a request does not specify one:
# ANTIGRAVITY_OAUTH_CLIENT_KEY=framecall_web

# Upstream Antigravity / Google Configuration (optional overrides)
REQUEST_TIMEOUT_MS=600000
MAX_CONCURRENT_REQUESTS_PER_ACCOUNT=10
